{
  "name": "template-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:all": "npx playwright test",
    "test:all:headed": "npx playwright test --headed",
    "test:tag": "npx playwright test --grep @tagName",
    "test:tag:headed": "npx playwright test --headed --grep @tagName",
    "test-smoke": "npx playwright test --grep @smoke",
    "report": "npx playwright show-report",
    "test:employee": "npm run allure:clean && playwright test tests/ui-test-example.spec.ts",
    "allure:clean": "node scripts/allure-report.cjs clean",
    "allure:generate": "npm run report:redact && node scripts/allure-report.cjs generate",
    "allure:open": "allure open allure-report",
    "report:redact": "node scripts/redact-reports.cjs",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:test": "cross-env TEST_ENV=test playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.6",
    "adm-zip": "^0.6.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3"
  }
}
